{
  "manifest_version": 3,
  "name": "Tab Group Bookmarks",
  "version": "1.1.0",
  "description": "Save tab groups to bookmark folders with matching names.",
  "permissions": ["tabGroups", "tabs", "bookmarks", "storage", "contextMenus"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tab Group Bookmarks"
  },
  "commands": {
    "save-current-group": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Save the current tab's group to bookmarks"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
