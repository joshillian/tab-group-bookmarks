{
  "manifest_version": 3,
  "name": "Tab Group Bookmarks",
  "version": "1.0.0",
  "description": "Save tab groups to bookmark folders with matching names.",
  "permissions": ["tabGroups", "tabs", "bookmarks", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tab Group Bookmarks"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
